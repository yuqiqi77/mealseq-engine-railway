  "source_steps": [
    {
      "no": 1,
      "text": "将粉丝放入温水浸泡20分钟"
    },
    {
      "no": 2,
      "text": "将茄子洗净 从中间切开"
    },
    {
      "no": 3,
      "text": "将葱 小米辣 蒜切末"
    },
    {
      "no": 4,
      "text": "将切好的葱末 小米辣 蒜末放入碗中 加入孜然粉 五香粉 胡椒粉 辣椒粉 花椒粉 生抽 盐 混合均匀制成蒜蓉酱"
    },
    {
      "no": 5,
      "text": "取锅倒油 打开方太磁控电磁灶 调至8档大火"
    },
    {
      "no": 6,
      "text": "将油烧热后浇入调好的蒜蓉酱中 搅拌均匀"
    },
    {
      "no": 7,
      "text": "另起一锅 倒油 打开方太磁控电磁灶 调至8档大火"
    },
    {
      "no": 8,
      "text": "油热后放入猪肉末翻炒 加入料酒和生抽在旺火中迅速搅拌 使汁水快速收干 盛出备用"
    },
    {
      "no": 9,
      "text": "将准备好的茄子放入铺有锡纸的烤盘中 用刷子在茄子表面刷一层油"
    },
    {
      "no": 10,
      "text": "打开方太智能烹饪设备 选择“开始烹饪”按键  按屏幕提示操作"
    },
    {
      "no": 11,
      "text": "烤制完成 取出茄子 在茄子上铺上粉丝 放上炒好的猪肉末"
    },
    {
      "no": 12,
      "text": "均匀地撒上调好的蒜蓉酱"
    },
    {
      "no": 13,
      "text": "再次放入烤箱烤10分钟"
    },
    {
      "no": 14,
      "text": "烤制完成 取出茄子 撒上葱花 放上小米辣装饰即可"
    }
  ],
