  ],
  "source_steps": [
    {
      "no": 1,
      "text": "将牛奶倒入锅中，加入淡奶油。"
    },
    {
      "no": 2,
      "text": "倒入细砂糖。"
    },
    {
      "no": 3,
      "text": "拌匀，用小火加热至细砂糖完全溶化。"
    },
    {
      "no": 4,
      "text": "蛋黄和鸡蛋倒入容器中，搅拌均匀。"
    },
    {
      "no": 5,
      "text": "倒入蜂蜜，混合均匀。"
    },
    {
      "no": 6,
      "text": "将煮好的牛奶液倒入蛋液中，混合均匀，制成布丁液。"
    },
    {
      "no": 7,
      "text": "将布丁液过筛至另一个容器中，这样可使布丁成品的口感更细腻。"
    },
    {
      "no": 8,
      "text": "草莓切成小粒，将草莓丁逐个放入挞皮中，逐个倒入布丁液。"
    },
    {
      "no": 9,
      "text": "放入预热好的烤箱中。"
    },
    {
      "no": 10,
      "text": "选择“常规烘焙”模式，以180℃烤20分钟。"
    },
    {
      "no": 11,
      "text": "取出，再逐个放上草莓粒即可。"
    }
  ],
