  "source_steps": [
    {
      "no": 1,
      "text": "将酵母倒入清水中，加入细砂糖。"
    },
    {
      "no": 2,
      "text": "拌匀至溶化。"
    },
    {
      "no": 3,
      "text": "高筋面粉倒入容器中。"
    },
    {
      "no": 4,
      "text": "加入鸡蛋、酵母糖水。"
    },
    {
      "no": 5,
      "text": "用软刮混合均匀，揉搓成面团。"
    },
    {
      "no": 6,
      "text": "将面团稍微拉平。"
    },
    {
      "no": 7,
      "text": "从一端向另一端卷起来，反复揉搓成纯滑的面团。"
    },
    {
      "no": 8,
      "text": "加入黄油、盐。"
    },
    {
      "no": 9,
      "text": "封好口将黄油和盐包裹住，揉成面团，再将面团稍微拉平，反复揉搓成光滑的面团。"
    },
    {
      "no": 10,
      "text": "面团放入容器中，用保鲜膜包好。"
    },
    {
      "no": 11,
      "text": "放入烤箱中。"
    },
    {
      "no": 12,
      "text": "选择“发酵”模式，以35℃发酵30分钟。"
    },
    {
      "no": 13,
      "text": "将发酵好的面团取出，用擀面杖擀平成圆形。"
    },
    {
      "no": 14,
      "text": "放入披萨盘中，刷上番茄酱。"
    },
    {
      "no": 15,
      "text": "放上培根片、玉米粒、彩椒丁，撒上芝士碎。"
    },
    {
      "no": 16,
      "text": "放入烤箱中。"
    },
    {
      "no": 17,
      "text": "选择“常规烘焙”模式，以180℃烤10分钟，取出即可。"
    }
  ],
