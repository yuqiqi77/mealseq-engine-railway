  "source_steps": [
    {
      "no": 1,
      "text": "食材准备"
    },
    {
      "no": 2,
      "text": "栗子剥皮洗净，锅里加水放入栗子煮软烂"
    },
    {
      "no": 3,
      "text": "煮软烂的栗子取出压烂"
    },
    {
      "no": 4,
      "text": "栗子泥倒入锅里"
    },
    {
      "no": 5,
      "text": "倒入适量色拉油炒，水分炒干，加入适量白糖，翻炒均匀后就可以做馅了"
    },
    {
      "no": 6,
      "text": "将牛奶，玉米油，糖粉倒入碗里搅拌均匀"
    },
    {
      "no": 7,
      "text": "将糯米粉，粘米粉，澄粉倒入1中"
    },
    {
      "no": 8,
      "text": "搅拌均匀，过筛下，静置半小时"
    },
    {
      "no": 9,
      "text": "放入方太智能烹饪设备第2层，开启电源，取出水箱加满水，选择“开始烹饪”按键，按屏幕提示操作"
    },
    {
      "no": 10,
      "text": "取出用筷子快速搅拌至顺滑，等冰皮凉了加入少量蒸熟的紫薯和成紫薯冰皮"
    },
    {
      "no": 11,
      "text": "将冰皮分成30克一个的小剂子，栗子分成20克一个的小剂子，手上沾少许油，将冰皮揉圆按扁，放上栗子"
    },
    {
      "no": 12,
      "text": "包好收口"
    },
    {
      "no": 13,
      "text": "放入模具，压出月饼形状"
    },
    {
      "no": 14,
      "text": "尽情享用美味的栗子饼皮月饼吧"
    }
  ],
