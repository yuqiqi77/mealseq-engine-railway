  "source_steps": [
    {
      "no": 1,
      "text": "将酵母倒入清水中，拌匀，至酵母溶化。"
    },
    {
      "no": 2,
      "text": "把高筋面粉倒在容器中，倒入奶粉、细砂糖。"
    },
    {
      "no": 3,
      "text": "加入酵母水。"
    },
    {
      "no": 4,
      "text": "倒入蛋黄。"
    },
    {
      "no": 5,
      "text": "用软刮充分拌匀，揉成面团。"
    },
    {
      "no": 6,
      "text": "将面团稍微拉平。"
    },
    {
      "no": 7,
      "text": "从一端向另一端卷起来，反复揉搓成纯滑的面团。"
    },
    {
      "no": 8,
      "text": "加入黄油。"
    },
    {
      "no": 9,
      "text": "封好口将黄油包裹住。"
    },
    {
      "no": 10,
      "text": "再将面团稍微拉平，反复揉搓成光滑的面团，放入容器中，用保鲜膜包好。"
    },
    {
      "no": 11,
      "text": "放入烤箱中。"
    },
    {
      "no": 12,
      "text": "选择“发酵”模式，以35℃发酵30分钟。"
    },
    {
      "no": 13,
      "text": "将发酵好的面团取出，分成7个大小一样的剂子，约每个25克，搓圆。"
    },
    {
      "no": 14,
      "text": "用擀面杖擀成小面皮。"
    },
    {
      "no": 15,
      "text": "面皮上放上适量的豆沙馅，封口，收紧。按照此方法将剩余的面团做好。"
    },
    {
      "no": 16,
      "text": "将生坯放入中空模具中。"
    },
    {
      "no": 17,
      "text": "放入烤箱。"
    },
    {
      "no": 18,
      "text": "选择“发酵”模式，以35℃发酵20分钟至两倍大。"
    },
    {
      "no": 19,
      "text": "将模式改成“常规烘焙”模式，以180℃烤12分钟。"
    },
    {
      "no": 20,
      "text": "打开箱门，取出即可。"
    }
  ],
