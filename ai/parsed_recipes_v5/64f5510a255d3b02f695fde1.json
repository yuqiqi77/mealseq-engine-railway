  "source_steps": [
    {
      "no": 1,
      "text": "食材准备"
    },
    {
      "no": 2,
      "text": "腊味切片，素鸡对半切开后切成5毫米的片，姜切丝，小葱切成葱花"
    },
    {
      "no": 3,
      "text": "素鸡在盘底铺圈，撒上盐、糖、料酒腌制入味"
    },
    {
      "no": 4,
      "text": "腊味铺在素鸡上面，加上姜丝"
    },
    {
      "no": 5,
      "text": "放入方太智能烹饪设备第2层，开启电源，取出水箱加满水，选择“开始烹饪”按键，按屏幕提示操作"
    },
    {
      "no": 6,
      "text": "取出后撒上葱花即可食用"
    },
    {
      "no": 7,
      "text": "尽情品尝吧"
    }
  ],
