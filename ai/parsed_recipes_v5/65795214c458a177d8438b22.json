  "source_steps": [
    {
      "no": 1,
      "text": "食材准备"
    },
    {
      "no": 2,
      "text": "牛奶放在小锅中，加白砂糖小火煮，放入红茶包一起加热，奶茶煮好后关火冷却"
    },
    {
      "no": 3,
      "text": "仙草冻粉加凉水搅拌至无颗粒状"
    },
    {
      "no": 4,
      "text": "加入小锅中，倒入开水"
    },
    {
      "no": 5,
      "text": "边小火加热边搅拌直至沸腾，即可制成糊"
    },
    {
      "no": 6,
      "text": "关火后将糊放入方形保鲜盒冷却至凝固（约需4小时），同时浸泡血糯米"
    },
    {
      "no": 7,
      "text": "冻好后倒扣切成小方块"
    },
    {
      "no": 8,
      "text": "血糯米放入方太智能烹饪设备，开启电源，取出水箱加满水，选择“开始烹饪”按键，按屏幕提示操作"
    },
    {
      "no": 9,
      "text": "将蒸熟的血糯米加一点椰汁混合均匀，放入杯中，再加冻块，最后倒入奶茶即可"
    },
    {
      "no": 10,
      "text": "尽情享用吧"
    }
  ],
