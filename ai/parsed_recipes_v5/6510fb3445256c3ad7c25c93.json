  "source_steps": [
    {
      "no": 1,
      "text": "食材准备"
    },
    {
      "no": 2,
      "text": "土豆清洗干净去皮切块"
    },
    {
      "no": 3,
      "text": "方太灶具调至6段火（中火）煮20分钟"
    },
    {
      "no": 4,
      "text": "煮好的土豆捞出，用勺子碾成土豆泥备用"
    },
    {
      "no": 5,
      "text": "洋葱、培根切碎，番茄切大片"
    },
    {
      "no": 6,
      "text": "热锅热油，将洋葱、培根倒入翻炒，炒香即可盛出"
    },
    {
      "no": 7,
      "text": "将洋葱、培根倒入到土豆泥中"
    },
    {
      "no": 8,
      "text": "加入食盐、黑胡椒粉、纯牛奶搅拌均匀"
    },
    {
      "no": 9,
      "text": "将土豆泥装入到盘中，将番茄片平放于土豆上"
    },
    {
      "no": 10,
      "text": "均匀地淋上番茄酱"
    },
    {
      "no": 11,
      "text": "将马苏里拉芝士碎铺在表面"
    },
    {
      "no": 12,
      "text": "打开方太智能烹饪设备，选择“开始烹饪”按键，按屏幕提示操作"
    },
    {
      "no": 13,
      "text": "烤好取出，芝士番茄土豆泥就做好了"
    }
  ],
