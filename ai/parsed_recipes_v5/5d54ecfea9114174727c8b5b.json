  ],
  "source_steps": [
    {
      "no": 1,
      "text": "将A料的食材倒入碗中，搅拌均匀。"
    },
    {
      "no": 2,
      "text": "揉成光滑的面团后搓粗条，制成油皮。"
    },
    {
      "no": 3,
      "text": "取B料食材倒入碗中，搅拌匀制面团，制成油酥。"
    },
    {
      "no": 4,
      "text": "油皮分切数个38克的小剂，油酥分切成数个16克小面团。"
    },
    {
      "no": 5,
      "text": "油皮压扁。"
    },
    {
      "no": 6,
      "text": "包住油酥，由下而上的卷起。"
    },
    {
      "no": 7,
      "text": "再擀制成擀制成椭圆的面片。"
    },
    {
      "no": 8,
      "text": "从面片一端向另一端卷起。"
    },
    {
      "no": 9,
      "text": "再擀平，然后再从一端向另一端卷起。"
    },
    {
      "no": 10,
      "text": "用手指按压接口处。"
    },
    {
      "no": 11,
      "text": "再从两端对折。"
    },
    {
      "no": 12,
      "text": "再用擀面杖擀成圆形的面皮。"
    },
    {
      "no": 13,
      "text": "填入枣馅儿，包入馅料边捏边旋转，使饼皮完全包裹住内陷。"
    },
    {
      "no": 14,
      "text": "将酥饼生坯放入垫有油纸的烤盘。"
    },
    {
      "no": 15,
      "text": "将酥饼压扁，放入烤箱。"
    },
    {
      "no": 16,
      "text": "选择“常规烘焙”模式，以180℃烤17分钟即可。"
    }
  ],
