  "recipe_id": "657951b7c458a177d84386bc",
  "name": "芋头蛋卷",
  "ingredients_raw": "主料：芋头3个；鸡蛋2个；食盐2克；食用油少许",
  "ingredients": [
    {
      "name": "芋头",
      "amount_text": "3个",
      "quantity": 3,
      "unit": "个",
      "role": "主料",
      "category": "素菜",
      "source_text": "主料：芋头3个"
    },
    {
      "name": "鸡蛋",
      "amount_text": "2个",
      "quantity": 2,
      "unit": "个",
      "role": "主料",
      "category": "荤菜",
      "source_text": "鸡蛋2个"
    },
    {
      "name": "食盐",
      "amount_text": "2克",
      "quantity": 2,
      "unit": "克",
      "role": "辅料",
      "category": "调味品",
      "source_text": "食盐2克"
    },
    {
      "name": "食用油",
      "amount_text": "少许",
      "quantity": null,
      "unit": null,
      "role": "辅料",
      "category": "调味品",
      "source_text": "食用油少许"
    }
  ],
  "source_steps": [
    {
      "no": 1,
      "text": "食材准备"
    },
    {
      "no": 2,
      "text": "芋头洗干净后放入方太智能烹饪设备，开启电源，取出水箱加满水，选择“开始烹饪”按键，按屏幕提示操作"
    },
    {
      "no": 3,
      "text": "鸡蛋打散加2g盐抽打均匀后用过滤网过滤一遍，这样蛋皮会更加细腻光滑"
    },
    {
      "no": 4,
      "text": "方太CS34BW磁控电磁灶小火1档，锅里用小火烧热，加一点点油、再倒入蛋液慢慢煎熟"
    },
    {
      "no": 5,
      "text": "慢慢煎熟以后用锅铲铲起翻一面，关火利用余温，一分钟后盛起"
    },
    {
      "no": 6,
      "text": "蒸熟后剥去外皮，用勺子压念成泥，越细腻越好"
    },
    {
      "no": 7,
      "text": "把煎好的蛋饼反正案板上，均匀涂抹上碾压好的芋泥"
    },
    {
      "no": 8,
      "text": "拿起一边卷向另一边"
    },
    {
      "no": 9,
      "text": "卷好后，均匀切成自己喜欢大小即可食用"
    },
    {
      "no": 10,
      "text": "清淡可口"
    }
  ],
