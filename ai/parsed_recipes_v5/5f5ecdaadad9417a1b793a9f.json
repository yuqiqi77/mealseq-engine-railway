  "name": "广式月饼（台式）",
  "ingredients_raw": "A料：转化糖浆105克；中筋粉153克；花生油22克；枧水3克；B料：豆沙馅630克；C料：蛋黄1个",
  "ingredients": [
    {
      "name": "转化糖浆",
      "amount_text": "105克",
