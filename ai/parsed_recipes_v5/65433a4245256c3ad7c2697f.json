  "source_steps": [
    {
      "no": 1,
      "text": "食材准备"
    },
    {
      "no": 2,
      "text": "鲈鱼两面横截三刀、葱切丝、姜切片备用"
    },
    {
      "no": 3,
      "text": "鱼放入碗中加入料酒和盐腌制15分钟"
    },
    {
      "no": 4,
      "text": "准备一鱼盘铺入姜片摆上腌制好的鱼，摆上葱丝、姜丝和香菜"
    },
    {
      "no": 5,
      "text": "放入方太智能烹饪设备，开启电源，取出水箱加满水，选择“开始烹饪”按键，按屏幕提示操作"
    },
    {
      "no": 6,
      "text": "蒸好之后淋上蒸鱼豉油，最后将圣女果摆入鲈鱼嘴中，烹饪完成即可食用"
    },
    {
      "no": 7,
      "text": "尽情品尝吧"
    }
  ],
