  "source_steps": [
    {
      "no": 1,
      "text": "准备食材"
    },
    {
      "no": 2,
      "text": "竹荪、干香菇温水泡发备用"
    },
    {
      "no": 3,
      "text": "生姜切片，小葱洗净打成葱节；香菜洗净切碎备用"
    },
    {
      "no": 4,
      "text": "方太灶具调至8段火（大火），倒入开水，放入姜片及葱节，加入料酒，下排骨焯水"
    },
    {
      "no": 5,
      "text": "焯好的排骨沥干，置于大碗中"
    },
    {
      "no": 6,
      "text": "放入泡发的竹荪、香菇以及枸杞，加入清水淹没，盖上保鲜膜。将装有食材的盘子放入蒸烤架/蒸烤盘"
    },
    {
      "no": 7,
      "text": "开启电源，取出水箱加满水，将蒸烤盘/蒸烤架放入中间层，选择【开始烹饪】按键，按屏幕提示操作即可"
    },
    {
      "no": 8,
      "text": "蒸好取出，加入香油、食盐调味"
    },
    {
      "no": 9,
      "text": "烹饪结束，放上香菜碎点缀，即可享用"
    },
    {
      "no": 10,
      "text": "竹荪排骨汤就做好了"
    }
  ],
