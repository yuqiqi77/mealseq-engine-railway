  "source_steps": [
    {
      "no": 1,
      "text": "食材准备"
    },
    {
      "no": 2,
      "text": "洋葱切末，大蒜切末，装入大碗中"
    },
    {
      "no": 3,
      "text": "加入五香粉、蚝油、生抽、料酒、油"
    },
    {
      "no": 4,
      "text": "搅拌均匀，制成腌料"
    },
    {
      "no": 5,
      "text": "姜切成姜丝，塞入鸡腹"
    },
    {
      "no": 6,
      "text": "腌料一部分填入鸡肚，另一部分抹在鸡表面，用手给鸡按摩入味"
    },
    {
      "no": 7,
      "text": "鸡表面撒上盐，继续按摩入味，腌制6小时以上"
    },
    {
      "no": 8,
      "text": "腌好后的鸡放在铺有锡纸的烤盘中，打开方太智能烹饪设备，选择“开始烹饪”按键，按屏幕提示操作"
    },
    {
      "no": 9,
      "text": "尽情享用吧"
    }
  ],
