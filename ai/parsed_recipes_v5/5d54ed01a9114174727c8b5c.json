    }
  ],
  "source_steps": [
    {
      "no": 1,
      "text": "将低筋面粉倒入容器中，在中间掏一个窝。"
    },
    {
      "no": 2,
      "text": "加入糖粉、盐、蛋黄，搅拌均匀。"
    },
    {
      "no": 3,
      "text": "加入备好的黄油，将四周的粉将中间覆盖，揉成光滑的面团。"
    },
    {
      "no": 4,
      "text": "案台上铺上一层保鲜膜，放上面团，稍微按压。"
    },
    {
      "no": 5,
      "text": "将面团擀成面皮。"
    },
    {
      "no": 6,
      "text": "用模具按压出小花模型，制成饼干生坯。"
    },
    {
      "no": 7,
      "text": "将生坯放入垫有油纸的烤盘中。"
    },
    {
      "no": 8,
      "text": "再用叉子压出花瓣形状。"
    },
    {
      "no": 9,
      "text": "放入烤箱中。"
    },
    {
      "no": 10,
      "text": "将装有饼坯的烤盘放入烤箱，关闭好。"
    },
    {
      "no": 11,
      "text": "选择“常规烘焙”模式，以170℃烤13分钟即可。"
    }
  ],
