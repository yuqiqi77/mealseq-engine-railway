  "source_steps": [
    {
      "no": 1,
      "text": "食材准备"
    },
    {
      "no": 2,
      "text": "肉馅中加入葱姜末、盐、料酒、生抽、食用油、香油"
    },
    {
      "no": 3,
      "text": "朝一个方向稍稍搅打上劲"
    },
    {
      "no": 4,
      "text": "长茄子去蒂切成夹刀片"
    },
    {
      "no": 5,
      "text": "切好的茄子每片之间塞满肉馅"
    },
    {
      "no": 6,
      "text": "码好放入盘中"
    },
    {
      "no": 7,
      "text": "开启电源，取出水箱加满水，选择“开始烹饪”按键，按屏幕提示操作。"
    },
    {
      "no": 8,
      "text": "炒锅放底油，放入葱姜蒜末、糖、蚝油爆香，倒入蒸茄子的汤汁"
    },
    {
      "no": 9,
      "text": "热好的汤汁浇在茄龙上即可"
    }
  ],
