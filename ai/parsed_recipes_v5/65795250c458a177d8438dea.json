  "source_steps": [
    {
      "no": 1,
      "text": "食材准备"
    },
    {
      "no": 2,
      "text": "鸡腿去掉骨头，切成小块"
    },
    {
      "no": 3,
      "text": "方太电磁灶开至9段大火，锅里烧开水，水开后加入2克食盐；将鸡腿丁倒入开水里焯水捞出，再将青豆放入开水里焯水捞出备用"
    },
    {
      "no": 4,
      "text": "用凉水冲洗干净备用"
    },
    {
      "no": 5,
      "text": "蒜拍碎，姜、葱切末"
    },
    {
      "no": 6,
      "text": "将焯水的鸡肉和青豆放入搅拌盆里面，将蒜瓣、姜末、葱末放在盆中"
    },
    {
      "no": 7,
      "text": "加入蚝油、番茄酱、黑胡椒、盐、淀粉、食用油放入盆中混合，腌制30分钟左右"
    },
    {
      "no": 8,
      "text": "南瓜切开，用小勺子将南瓜掏空"
    },
    {
      "no": 9,
      "text": "再将腌制好的鸡肉和青豆放入南瓜盅里面"
    },
    {
      "no": 10,
      "text": "放入方太智能烹饪设备，开启电源，取出水箱加满水，选择“开始烹饪”按键，按屏幕提示操作"
    },
    {
      "no": 11,
      "text": "取出撒上葱花即可食用"
    },
    {
      "no": 12,
      "text": "尽情品尝吧"
    }
  ],
