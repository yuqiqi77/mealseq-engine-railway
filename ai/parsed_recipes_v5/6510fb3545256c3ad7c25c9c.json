  "source_steps": [
    {
      "no": 1,
      "text": "食材准备"
    },
    {
      "no": 2,
      "text": "主料中的面粉、糖、盐混合均匀"
    },
    {
      "no": 3,
      "text": "加入黄油丁，再加入50克水"
    },
    {
      "no": 4,
      "text": "用手搓成面包屑状"
    },
    {
      "no": 5,
      "text": "均匀地倒入1份蛋液，混匀，稍揉几下使其形成面团"
    },
    {
      "no": 6,
      "text": "将面团分为均等的两份，分别用保鲜膜包裹起来，放冰箱冷藏1小时"
    },
    {
      "no": 7,
      "text": "苹果切成厚片，芒果削皮去核切片，加入香草精"
    },
    {
      "no": 8,
      "text": "再将淀粉与细砂糖加入水果片中，拌匀"
    },
    {
      "no": 9,
      "text": "面团从冰箱中取出，案板上撒少许面粉，将面团擀开成直径约为25cm的圆形"
    },
    {
      "no": 10,
      "text": "将一半的水果放入派皮中间，边缘留出约3cm的边，依次往同一个方向折起派皮"
    },
    {
      "no": 11,
      "text": "将派皮放在铺有锡纸的蒸烤盘上，周围刷上蛋液，撒些粗糖"
    },
    {
      "no": 12,
      "text": "打开方太智能烹饪设备，选择“开始烹饪”按键，按屏幕提示操作"
    },
    {
      "no": 13,
      "text": "将烤好的派从烤箱中取出，把蜂蜜刷在表面即可"
    },
    {
      "no": 14,
      "text": "尽情享用吧"
    }
  ],
