  "source_steps": [
    {
      "no": 1,
      "text": "食材准备"
    },
    {
      "no": 2,
      "text": "五花肉洗净小块，素鸡切成5毫米左右厚的片，年糕切薄片"
    },
    {
      "no": 3,
      "text": "方太燃气灶开大火（7档），锅内倒油，先将素鸡小火煎至两面微黄"
    },
    {
      "no": 4,
      "text": "随后盛出，用凉水浸泡5分钟"
    },
    {
      "no": 5,
      "text": "将处理过的素鸡、年糕片，均匀码在有一定深度的碗中"
    },
    {
      "no": 6,
      "text": "锅内不倒油，放入五花肉煸至边缘微黄，逼出部分猪油"
    },
    {
      "no": 7,
      "text": "热锅凉油放入冰糖（糖和油的比例大致为1:1），中小火翻炒至冰糖融化、颜色接近红棕色时放入五花肉上色"
    },
    {
      "no": 8,
      "text": "猪肉均匀上色后加入1汤勺老抽、2汤勺生抽、2汤勺料酒和2碗热水"
    },
    {
      "no": 9,
      "text": "大火（7档）烧开后转小火（2档），盖上盖子煮20分钟。汤汁浓稠后，加入少许盐调味即可"
    },
    {
      "no": 10,
      "text": "用筷子将炖好的猪肉，挨个放到刚刚的碗里，再均匀淋一些肉汁"
    },
    {
      "no": 11,
      "text": "放入方太智能烹饪设备，开启电源，取出水箱加满水，选择“开始烹饪”按键，按屏幕提示操作"
    },
    {
      "no": 12,
      "text": "尽情享用吧"
    }
  ],
