  "source_steps": [
    {
      "no": 1,
      "text": "洗净的鲫鱼装盘，放上姜片和干辣椒。"
    },
    {
      "no": 2,
      "text": "往两面鱼身上淋入料酒，撒上盐和适量胡椒粉，抹匀，腌渍10分钟至入味。"
    },
    {
      "no": 3,
      "text": "在烤盘中铺上锡纸，将烤串放在烤架上，刷上适量食用油。"
    },
    {
      "no": 4,
      "text": "将烤盘置入烤箱中。"
    },
    {
      "no": 5,
      "text": "选择“完全烧烤”模式，以200℃烤20分钟。"
    },
    {
      "no": 6,
      "text": "取出烤盘，放上葱花即可。"
    }
  ],
