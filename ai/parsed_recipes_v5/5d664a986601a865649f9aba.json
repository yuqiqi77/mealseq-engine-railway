  "source_steps": [
    {
      "no": 1,
      "text": "把低筋面粉倒在容器中，放入香草粉。"
    },
    {
      "no": 2,
      "text": "倒入糖粉、蛋清，搅匀。"
    },
    {
      "no": 3,
      "text": "倒入黄油。"
    },
    {
      "no": 4,
      "text": "将材料混合均匀。"
    },
    {
      "no": 5,
      "text": "揉搓成香草面团。"
    },
    {
      "no": 6,
      "text": "把低筋面粉倒在另一个容器中，放入可可粉。"
    },
    {
      "no": 7,
      "text": "倒入白糖、鸡蛋，用刮板搅匀。"
    },
    {
      "no": 8,
      "text": "加入黄油。"
    },
    {
      "no": 9,
      "text": "将材料混合均匀，揉搓圆，制成巧克力面团。"
    },
    {
      "no": 10,
      "text": "将巧克力面团、香草面团混合均匀。"
    },
    {
      "no": 11,
      "text": "揉搓成直径为4厘米的长条状。"
    },
    {
      "no": 12,
      "text": "用油纸将长条面团包住，放入冰箱冷冻20分钟至定型。"
    },
    {
      "no": 13,
      "text": "取出，撕去油纸，切成直径为0.5厘米等同的片状，制成饼干生坯。"
    },
    {
      "no": 14,
      "text": "将生坯放入垫有油纸的烤盘中。"
    },
    {
      "no": 15,
      "text": "放入烤箱中。"
    },
    {
      "no": 16,
      "text": "选择“常规烘焙”模式，以180℃烤制15分钟."
    },
    {
      "no": 17,
      "text": "打开箱门，取出烤好的饼干即可。"
    }
  ],
