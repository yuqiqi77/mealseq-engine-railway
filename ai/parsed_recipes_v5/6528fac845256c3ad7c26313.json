  "source_steps": [
    {
      "no": 1,
      "text": "食材准备"
    },
    {
      "no": 2,
      "text": "椰浆和水，木薯粉和粘米粉分别混合均匀，把适量的水倒进混合好的砵仔糕粉中，水量不需要太多，刚好能把粉调成浓稠的粉浆即可"
    },
    {
      "no": 3,
      "text": "把糖加入椰浆水中，方太燃气灶开大火（9档）煮沸"
    },
    {
      "no": 4,
      "text": "把煮沸的椰浆糖水迅速倒进粉浆中与粉浆搅拌均匀，把生浆烫成熟浆"
    },
    {
      "no": 5,
      "text": "把粉浆倒进模具中放进适量的蜜红豆"
    },
    {
      "no": 6,
      "text": "放入方太智能烹饪设备，开启电源，取出水箱加满水，选择“开始烹饪”按键，按屏幕提示操作"
    },
    {
      "no": 7,
      "text": "尽情品尝吧"
    }
  ],
