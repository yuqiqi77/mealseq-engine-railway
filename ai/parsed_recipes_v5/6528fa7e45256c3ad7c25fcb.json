  "name": "豆沙松糕",
  "ingredients_raw": "主料：粘米粉200克；糯米粉80克；辅料：水150克；绵白糖40克；豆沙馅150克",
  "ingredients": [
    {
      "name": "粘米粉",
      "amount_text": "200克",
      "quantity": 200,
      "unit": "克",
      "role": "主料",
      "category": "素菜",
      "source_text": "主料：粘米粉200克"
    },
    {
      "name": "糯米粉",
      "amount_text": "80克",
      "quantity": 80,
      "unit": "克",
