      "category": "素菜",
      "source_text": "糯米粉80克"
    },
    {
      "name": "水",
      "amount_text": "150克",
      "quantity": 150,
      "unit": "克",
      "role": "辅料",
      "category": "调味品",
      "source_text": "辅料：水150克"
    },
    {
      "name": "绵白糖",
      "amount_text": "40克",
      "quantity": 40,
      "unit": "克",
      "role": "辅料",
      "category": "调味品",
      "source_text": "绵白糖40克"
    },
    {
      "name": "豆沙馅",
      "amount_text": "150克",
      "quantity": 150,
      "unit": "克",
      "role": "辅料",
      "category": "素菜",
      "source_text": "豆沙馅150克"
    }
  ],
  "source_steps": [
    {
      "no": 1,
      "text": "食材准备"
    },
    {
      "no": 2,
      "text": "粘米粉、糯米粉、绵白糖混合均匀"
    },
    {
      "no": 3,
      "text": "边加水边翻拌成半湿的状态，再用双手搓成潮湿、松散的粉粒"
    },
    {
      "no": 4,
      "text": "将搓好的粉过筛"
    },
    {
      "no": 5,
      "text": "在模具底部喷上少许油，取一半细粉倒入铺平"
    },
    {
      "no": 6,
      "text": "放入方太智能烹饪设备，开启电源，取出水箱加满水，选择“开始烹饪”按键，按屏幕提示操作"
    },
    {
      "no": 7,
      "text": "取出，铺上豆沙馅"
    },
    {
      "no": 8,
      "text": "将剩下的细粉倒入盖住豆沙馅，表面刮平"
    },
    {
      "no": 9,
      "text": "再次放入方太智能烹饪设备，选择蒸模式-普通蒸，100℃，25分钟，无需预热"
    },
    {
      "no": 10,
      "text": "放凉后切块即可，尽情享用美味的豆沙松糕吧"
    }
  ],
