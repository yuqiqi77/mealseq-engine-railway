  "source_steps": [
    {
      "no": 1,
      "text": "食材准备"
    },
    {
      "no": 2,
      "text": "莴苣去皮，切成3厘米左右的莴苣段"
    },
    {
      "no": 3,
      "text": "将莴苣段用小刀掏成底部边缘大致为3毫米左右的空心状，备用"
    },
    {
      "no": 4,
      "text": "生姜、大葱、小葱都切末"
    },
    {
      "no": 5,
      "text": "肉末至大碗中，加入姜末、葱末；倒入食用油、食盐、生抽、生粉"
    },
    {
      "no": 6,
      "text": "将其搅拌均匀，制成肉馅"
    },
    {
      "no": 7,
      "text": "将肉馅酿到莴苣段中，稍鼓起"
    },
    {
      "no": 8,
      "text": "将莴苣放入方太智能烹饪设备，开启电源，取出水箱加满水，选择“开始烹饪”按键，按屏幕提示操作"
    },
    {
      "no": 9,
      "text": "蒸好取出，淋上香油"
    },
    {
      "no": 10,
      "text": "清新的酿莴苣就做好了"
    }
  ],
