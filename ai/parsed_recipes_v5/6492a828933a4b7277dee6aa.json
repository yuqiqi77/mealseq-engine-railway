  "name": "蜜豆卷馒头",
  "ingredients_raw": "主料：蜜豆50克；面粉150克；辅料：酵母1.5克；糖10克；水70毫升",
  "ingredients": [
    {
      "name": "蜜豆",
      "amount_text": "50克",
      "quantity": 50,
