{
  "schema_version": 5,
  "recipe_id": "65781f17c458a177d8438652",
  "name": "巴斯克蛋糕",
  "ingredients_raw": "主料：奶油奶酪350克；辅料：鸡蛋4个；淡奶油180克；玉米淀粉12克；细砂糖80克",
  "ingredients": [
    {
      "name": "奶油奶酪",
      "amount_text": "350克",
      "quantity": 350,
      "unit": "克",
      "role": "主料",
      "category": "荤菜",
      "source_text": "主料：奶油奶酪350克"
    },
    {
      "name": "鸡蛋",
      "amount_text": "4个",
      "quantity": 4,
      "unit": "个",
      "role": "辅料",
      "category": "荤菜",
      "source_text": "辅料：鸡蛋4个"
    },
    {
      "name": "淡奶油",
      "amount_text": "180克",
      "quantity": 180,
      "unit": "克",
      "role": "辅料",
      "category": "荤菜",
      "source_text": "淡奶油180克"
    },
    {
      "name": "玉米淀粉",
      "amount_text": "12克",
      "quantity": 12,
      "unit": "克",
      "role": "辅料",
      "category": "调味品",
      "source_text": "玉米淀粉12克"
    },
    {
      "name": "细砂糖",
      "amount_text": "80克",
      "quantity": 80,
      "unit": "克",
      "role": "辅料",
      "category": "调味品",
      "source_text": "细砂糖80克"
    }
  ],
  "source_steps": [
    {
      "no": 1,
      "text": "奶油奶酪放入盆中，隔热水融成膏体状。"
    },
    {
      "no": 2,
      "text": "在融化的奶油奶酪中加入细砂糖，搅打至顺滑。"
    },
    {
      "no": 3,
      "text": "加入鸡蛋，搅打至完全融合。"
    },
    {
      "no": 4,
      "text": "加入淡奶油和玉米淀粉，混合均匀后过筛备用。"
    },
    {
      "no": 5,
      "text": "倒入铺好油纸的6寸蛋糕模具中，将模具放入蒸烤盘中央。"
    },
    {
      "no": 6,
      "text": "开启电源，选择“开始烹饪”按键，按屏幕提示操作。"
    },
    {
      "no": 7,
      "text": "烹饪结束，取出蛋糕模具，放凉后放入冰箱冷藏两小时后即可脱模。"
    }
  ],
