  ],
  "source_steps": [
    {
      "no": 1,
      "text": "洋葱、胡萝卜均洗净切碎；火腿肠先切细条，再切碎。"
    },
    {
      "no": 2,
      "text": "鸡翅洗净，去骨，翅尖处留骨，装入碗中。"
    },
    {
      "no": 3,
      "text": "碗中加盐、油、胡椒粉、料酒腌渍。"
    },
    {
      "no": 4,
      "text": "锅中注油烧热，放入蔬菜、火腿肠、米饭炒匀。"
    },
    {
      "no": 5,
      "text": "加盐、胡椒粉、韩式辣椒酱拌炒片刻，盛出装碗。"
    },
    {
      "no": 6,
      "text": "将炒饭装入鸡翅中，用牙签封口，翅尖用锡纸包住。"
    },
    {
      "no": 7,
      "text": "烤盘内铺上一层锡纸，在锡纸上刷油，放入鸡翅，鸡翅表面刷油。"
    },
    {
      "no": 8,
      "text": "将烤盘放入烤箱中。"
    },
    {
      "no": 9,
      "text": "关上烤箱门，选择“常规烘焙”模式，以180℃烤15分钟。"
    },
    {
      "no": 10,
      "text": "打开烤箱门，将烤好的鸡翅包饭取出即可。"
    }
  ],
